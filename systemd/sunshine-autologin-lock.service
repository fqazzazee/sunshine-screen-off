# Lock the desktop immediately after GDM auto-login (no-op for password logins).
[Unit]
Description=Lock the GNOME session after auto-login
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/sunshine-autologin-lock

[Install]
WantedBy=graphical-session.target
