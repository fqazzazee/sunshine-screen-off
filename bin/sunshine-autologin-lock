#!/usr/bin/env bash
# Lock the GNOME session right after GDM auto-login, so booting straight into
# the desktop (for Sunshine) doesn't leave it open to anyone at the desk.
# Sessions started with a password are left alone.
set -u

session=$(loginctl show-user "$USER" -p Display --value)
[ -n "$session" ] || exit 0
[ "$(loginctl show-session "$session" -p Service --value)" = gdm-autologin ] || exit 0

# gnome-shell may not own org.gnome.ScreenSaver yet; retry for up to 30 s.
for _ in $(seq 60); do
    if gdbus call --session --dest org.gnome.ScreenSaver --object-path /org/gnome/ScreenSaver \
            --method org.gnome.ScreenSaver.Lock >/dev/null 2>&1; then
        sleep 1
        gdbus call --session --dest org.gnome.ScreenSaver --object-path /org/gnome/ScreenSaver \
            --method org.gnome.ScreenSaver.GetActive 2>/dev/null | grep -q true && exit 0
    fi
    sleep 0.5
done
# Last resort: ask logind, which gnome-shell also listens to.
loginctl lock-session "$session"
