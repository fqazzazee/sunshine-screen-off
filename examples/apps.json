{
    "apps": [
        {
            "image-path": "desktop.png",
            "name": "Desktop",
            "prep-cmd": [
                {
                    "do": "sunshine-virtual-display reset",
                    "undo": ""
                }
            ]
        },
        {
            "detached": [
                "sunshine-steam steam://open/bigpicture"
            ],
            "image-path": "steam.png",
            "name": "Steam Big Picture",
            "prep-cmd": [
                {
                    "do": "sunshine-virtual-display reset",
                    "undo": ""
                },
                {
                    "do": "",
                    "undo": "sunshine-steam steam://close/bigpicture"
                }
            ]
        },
        {
            "image-path": "desktop.png",
            "name": "Desktop (Screen Off)",
            "prep-cmd": [
                {
                    "do": "sunshine-virtual-display start",
                    "undo": "sunshine-virtual-display stop"
                }
            ]
        },
        {
            "detached": [
                "sunshine-steam steam://open/bigpicture"
            ],
            "image-path": "steam.png",
            "name": "Steam Big Picture (Screen Off)",
            "prep-cmd": [
                {
                    "do": "sunshine-virtual-display start",
                    "undo": "sunshine-virtual-display stop"
                },
                {
                    "do": "",
                    "undo": "sunshine-steam steam://close/bigpicture"
                }
            ]
        }
    ],
    "env": {
        "PATH": "$(PATH):$(HOME)/.local/bin"
    }
}
